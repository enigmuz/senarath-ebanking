# ============================================================================
# Senarath Bank — Online Banking environment (LAB ENVIRONMENT)
# ----------------------------------------------------------------------------
# INTENTIONAL WEAKNESS V6 — these database credentials are stored here in
# PLAINTEXT and injected into the web container's environment, readable by the
# web process. After RCE (V5), dumping the environment recovers these working
# MSSQL credentials, which authenticate to SQL01 over TCP 1433 (pivot, stage 9).
#
# These are the FIXED synthetic lab values from the build guide (p.13/p.15).
# Never reuse them outside this isolated lab. This file is intentionally
# COMMITTED to the repo for the exercise (normally .env must never be committed).
# ============================================================================

# --- MSSQL (internal host SQL01) ---
# Set DB_HOST to SQL01's reachable name or IP from WEB01.
DB_HOST=SQL01.senarath.local
DB_PORT=1433
DB_NAME=SenarathLab
DB_USER=lab_app
DB_PASSWORD=DbLab123!

# --- App ---
APP_DEBUG=1
LAB_FIXED_OTP=114477
ONLINE_BANKING_URL=https://ebanking.senarathbank.com
CORPORATE_URL=https://senarathbank.com
